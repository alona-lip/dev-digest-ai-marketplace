{
  "name": "dev-digest-catalog-site",
  "private": true,
  "version": "0.1.0",
  "description": "Static catalog site for the dev-digest-ai-marketplace, deployed to GitHub Pages",
  "type": "module",
  "scripts": {
    "catalog": "tsx scripts/build-catalog.ts",
    "predev": "npm run catalog",
    "dev": "vite",
    "prebuild": "npm run catalog",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "minisearch": "7.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "marked": "14.1.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "yaml": "2.6.1"
  }
}
